<resources>
    <style name="Theme.UniversalRemote" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#F5F5F5</item>
        <item name="colorPrimaryVariant">#D0D0D0</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">#FFFFFF</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSurface">#161616</item>
        <item name="colorOnSurface">#F5F5F5</item>
        <item name="colorAccent">#FFFFFF</item>
        <item name="colorControlHighlight">#30FFFFFF</item>
        <item name="colorButtonNormal">#252525</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:textColorPrimary">#F5F5F5</item>
        <item name="android:textColorSecondary">#BDBDBD</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="alertDialogTheme">@style/Theme.UniversalRemote.Dialog</item>
    </style>
    <style name="Theme.UniversalRemote.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorSecondary">#FFFFFF</item>
        <item name="colorAccent">#FFFFFF</item>
        <item name="android:colorBackground">#161616</item>
        <item name="colorSurface">#161616</item>
        <item name="android:textColorPrimary">#F5F5F5</item>
        <item name="android:textColorSecondary">#BDBDBD</item>
        <item name="android:windowAnimationStyle">@style/Animation.UniversalRemote.Dialog</item>
    </style>
    <style name="Animation.UniversalRemote.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
</resources>
